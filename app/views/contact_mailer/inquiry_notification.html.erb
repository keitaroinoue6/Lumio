<h2>新しいお問い合わせが届きました</h2>

<table style="border-collapse: collapse; width: 100%;">
  <tr>
    <th style="text-align: left; padding: 8px; border: 1px solid #ddd; background: #f5f5f5;">項目</th>
    <th style="text-align: left; padding: 8px; border: 1px solid #ddd; background: #f5f5f5;">内容</th>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">お問い合わせ種別</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.topic %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">会社名</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.company %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">業種</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.industry %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">お名前</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.name %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">部署名</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.department %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">メールアドレス</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.email %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">電話番号</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.phone %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">ご予算</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.budget %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">導入希望時期</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.start_date %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">契約形態</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= @contact.engagement %></td>
  </tr>
  <tr>
    <td style="padding: 8px; border: 1px solid #ddd;">お問い合わせ内容</td>
    <td style="padding: 8px; border: 1px solid #ddd;"><%= simple_format(@contact.detail) %></td>
  </tr>
</table>
