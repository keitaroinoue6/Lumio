<% content_for :title, "Portfolio" %>
<% content_for :description, "制作実績の入り口ページです。各プロジェクトのLPやコーポレートサイトに遷移できます。" %>

<% content_for :head do %>
<style>
.portfolio {
  padding: 96px 0 110px;
  background:
    radial-gradient(55% 50% at 90% 10%, #eaeefb 0%, transparent 65%),
    radial-gradient(45% 45% at 10% 90%, #f4ebec 0%, transparent 65%),
    var(--bg);
}
.portfolio h1 {
  font-size: clamp(38px, 5vw, 62px);
  line-height: 1.22;
  letter-spacing: -0.01em;
}
.portfolio .lede {
  margin-top: 22px;
  max-width: 62ch;
}
.works-grid {
  margin-top: 44px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
.work-card {
  display: flex;
  flex-direction: column;
  gap: 14px;
  border: 1px solid var(--line-2);
  border-radius: var(--radius-lg);
  background: #fff;
  padding: 28px;
}
.work-card .eyebrow {
  margin: 0;
}
.work-card h2 {
  font-size: 24px;
  line-height: 1.45;
}
.work-card p {
  color: var(--ink-2);
  margin: 0;
}
.work-card .actions {
  margin-top: auto;
}
.work-card.featured {
  grid-column: 1 / -1;
  padding: 38px;
  gap: 18px;
}
.work-card.featured h2 {
  font-size: clamp(30px, 3.5vw, 42px);
  line-height: 1.3;
}
.work-card.featured p {
  font-size: 18px;
  line-height: 1.9;
  max-width: 72ch;
}
.work-card.featured .actions .btn {
  font-size: 16px;
  padding: 14px 24px;
}
.system-work-gallery {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
.system-work-visual {
  background: #fff;
  border: 1px solid var(--line-2);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.system-work-visual img {
  width: 100%;
  height: 260px;
  object-fit: contain;
  display: block;
  background: #f4f6fb;
  padding: 12px;
}
.system-work-visual .placeholder {
  width: 100%;
  height: 260px;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, #eef2fb 0%, #f7edf1 100%);
  color: var(--ink-3);
  font-family: var(--font-en);
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-bottom: 1px solid var(--line-2);
}
.system-work-visual .body {
  padding: 18px 20px 22px;
}
.system-work-visual h3 {
  font-size: 17px;
  line-height: 1.5;
}
.system-work-visual p {
  margin-top: 10px;
  margin-bottom: 0;
  color: var(--ink-2);
  font-size: 14px;
  line-height: 1.85;
}

@media (max-width: 980px) {
  .works-grid {
    grid-template-columns: 1fr;
  }
  .work-card.featured {
    padding: 30px;
  }
  .work-card.featured p {
    font-size: 16px;
  }
  .system-work-gallery {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 1280px) and (min-width: 981px) {
  .system-work-gallery {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>
<% end %>

<section class="portfolio">
  <div class="container">
    <span class="eyebrow">Portfolio</span>
    <h1 style="margin-top: 16px;">制作実績一覧</h1>
    <p class="lede">
      トップページから各実績ページへ遷移できます。まずは仮の導線として、
      現在のITコーポレートサイトに移動できるようにしています。
    </p>

    <div class="works-grid">
      <article class="work-card">
        <span class="eyebrow">Work 01</span>
        <h2>ITコーポレートサイト</h2>
        <p>企業ブランディングを意識した
          IT企業向けコーポレートサイトです。
          会社概要・サービス・お問い合わせ導線を含みます。</p>
        <div class="actions">
          <%= link_to it_corporate_path, class: "btn btn-primary" do %>
            サイトを見る
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          <% end %>
        </div>
      </article>

      <article class="work-card">
        <span class="eyebrow">Work 02</span>
        <h2>レンタカーLP</h2>
        <p>予約導線と問い合わせ獲得を重視した
          レンタカー向けLPページです。</p>
        <div class="actions">
          <%= link_to renta_car_path, class: "btn btn-primary" do %>
            サイトを見る
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          <% end %>
        </div>
      </article>

      <article class="work-card featured">
        <span class="eyebrow">System Development</span>
        <h2>システム開発実績</h2>
        <p>レンタカー業務の改善や運用最適化につながるシステム開発実績を、代表的な画面とともに紹介しています。
          その他では車検の自動通知やリピート率の可視化などを行っています。</p>
        <div class="actions">
          <span class="btn btn-ghost" style="pointer-events: none; opacity: .7;">下記に実績を掲載中</span>
        </div>
      </article>

      <div class="system-work-gallery">
        <article class="system-work-visual">
          <%= image_tag "system_works/system_work_line.png", alt: "LINE連携で予約確認を通知する画面" %>
          <div class="body">
            <h3>LINE連携による予約確認の自動通知</h3>
            <p>申し込み内容を自動通知し、対応漏れ防止と業務効率化を実現。</p>
          </div>
        </article>

        <article class="system-work-visual">
          <%= image_tag "system_works/system_work_admin.png", alt: "予約一覧を管理する管理画面" %>
          <div class="body">
            <h3>予約一覧・絞り込み管理画面</h3>
            <p>予約ステータスや支払方法など複数条件で絞り込み、予約・顧客・ステータス管理を一元化し、確認業務を効率化。</p>
          </div>
        </article>

        <article class="system-work-visual">
          <%= image_tag "system_works/system_work_analytics.png", alt: "月別予約数の可視化ダッシュボード画面" %>
          <div class="body">
            <h3>月別予約推移の可視化ダッシュボード</h3>
            <p>月別・拠点別データを可視化し、運営改善と意思決定を支援。</p>
          </div>
        </article>

        <article class="system-work-visual">
          <%= image_tag "system_works/system_work_stripe_logo.png", alt: "Stripe公式ロゴ画像" %>
          <div class="body">
            <h3>Stripe決済連携</h3>
            <p>クレジットカード決済をStripeで安全に処理。予約フローから決済完了までをシームレスに連携し、管理画面への反映まで自動化。</p>
          </div>
        </article>

        <article class="system-work-visual">
          <%= image_tag "system_works/system_work_status_notification.png", alt: "ステータス変更時に自動送信される通知画面" %>
          <div class="body">
            <h3>ステータス変更時の自動メッセージ通知</h3>
            <p>「確定」「キャンセル」などのステータス変更に応じて通知文面を自動送信。案内漏れを減らし、顧客対応の速度と品質を向上。</p>
          </div>
        </article>
      </div>
    </div>
  </div>
</section>
