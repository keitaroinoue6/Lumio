<script>
(function() {
  var els = document.querySelectorAll('.pf .reveal');
  function show(el) { el.classList.add('in'); }
  function check(el) {
    var r = el.getBoundingClientRect();
    var vh = window.innerHeight || document.documentElement.clientHeight;
    return r.top < vh * 0.95 && r.bottom > 0;
  }
  els.forEach(function(el) {
    if (check(el)) { show(el); return; }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) { if (e.isIntersecting) { show(e.target); io.unobserve(e.target); } });
      }, { threshold: 0.1, rootMargin: '0px 0px -6% 0px' });
      io.observe(el);
    } else {
      setTimeout(function() { show(el); }, 1600);
    }
  });
  window.addEventListener('scroll', function() {
    els.forEach(function(el) { if (!el.classList.contains('in') && check(el)) show(el); });
  }, { passive: true });
})();
</script>
