<script>
  function rcToggleFaq(i) {
    var answer = document.getElementById('rc-faq-answer-' + i);
    var icon   = document.getElementById('rc-faq-icon-' + i);
    var isOpen = answer.classList.contains('open');
    document.querySelectorAll('.rc-faq-answer').forEach(function(el){ el.classList.remove('open'); });
    document.querySelectorAll('.rc-faq-icon').forEach(function(el){ el.classList.remove('open'); });
    if (!isOpen) {
      answer.classList.add('open');
      icon.classList.add('open');
    }
  }
</script>
