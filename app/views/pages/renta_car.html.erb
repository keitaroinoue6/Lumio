<% content_for :title, "マチナカレンタカー — 福岡・糸島の街乗りレンタカー" %>

<% content_for :head do %>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;700;900&family=Zen+Kaku+Gothic+New:wght@500;700;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --rc-bg:      #FBF7F0;
    --rc-hero-bg: #F4EDE0;
    --rc-text:    #2A2522;
    --rc-muted:   #6B635B;
    --rc-border:  #E4DCCB;
    --rc-accent:  #E8693B;
    --rc-card:    #FFFFFF;
    --rc-cta-bg:  #2A2522;
    --rc-line:    #06C755;
  }
  .rc * { box-sizing: border-box; }
  .rc { font-family: "Noto Sans JP", sans-serif; background: var(--rc-bg); color: var(--rc-text); -webkit-font-smoothing: antialiased; }
  .rc-container { max-width: 1280px; margin: 0 auto; padding: 0 48px; }

  /* ── Header ── */
  .rc-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(251,247,240,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rc-border);
    padding: 14px 48px;
    display: flex; align-items: center; justify-content: space-between;
  }
  .rc-header-brand {
    font-family: "Zen Kaku Gothic New", sans-serif;
    font-weight: 900; font-size: 18px; letter-spacing: 0.3px;
    color: var(--rc-text); line-height: 1.1; text-decoration: none;
  }
  .rc-header-brand span { font-size: 9px; font-weight: 500; letter-spacing: 2px; opacity: 0.7; display: block; }
  .rc-nav { display: flex; gap: 28px; align-items: center; }
  .rc-nav a {
    font-family: "Noto Sans JP", sans-serif; font-size: 13px; font-weight: 600;
    color: var(--rc-text); text-decoration: none; transition: opacity .15s;
  }
  .rc-nav a:hover { opacity: 0.6; }
  .rc-nav-back {
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--rc-border);
    background: #fff;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }
  .rc-nav-back:hover { opacity: 1; background: #f7f0e5; }
  .rc-btn-line {
    padding: 10px 18px; border-radius: 22px; border: none;
    background: var(--rc-line); color: #fff;
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 700; font-size: 13px;
    display: flex; align-items: center; gap: 6px; cursor: pointer;
    box-shadow: 0 4px 12px rgba(6,199,85,0.25);
    white-space: nowrap; text-decoration: none;
  }
  .rc-btn-line-lg {
    padding: 18px 28px; border-radius: 32px; border: none;
    background: var(--rc-line); color: #fff;
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 700; font-size: 15px; letter-spacing: 1px;
    display: inline-flex; align-items: center; gap: 10px; cursor: pointer;
    box-shadow: 0 8px 24px rgba(6,199,85,0.3); white-space: nowrap; text-decoration: none;
  }
  .rc-btn-outline {
    padding: 18px 28px; border-radius: 32px;
    border: 1.5px solid var(--rc-text); background: transparent; color: var(--rc-text);
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 700; font-size: 15px;
    cursor: pointer; white-space: nowrap; text-decoration: none; display: inline-block;
  }

  /* ── Section header util ── */
  .rc-eyebrow {
    font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 3px;
    color: var(--rc-accent); margin-bottom: 14px;
    display: flex; align-items: center; gap: 10px;
  }
  .rc-eyebrow::before { content: ""; display: block; width: 24px; height: 1px; background: var(--rc-accent); }
  .rc-section-title {
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 900; font-size: 48px;
    line-height: 1.1; color: var(--rc-text); margin: 0; letter-spacing: -1.5px;
  }

  /* ── Hero ── */
  .rc-hero { background: var(--rc-hero-bg); padding: 64px 48px 72px; overflow: hidden; }
  .rc-hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; }
  .rc-hero h1 {
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 900; font-size: 84px;
    line-height: 1; margin: 0; letter-spacing: -3px;
  }
  .rc-hero h1 .accent { color: var(--rc-accent); }
  .rc-hero-sub { font-size: 16px; line-height: 1.9; color: var(--rc-muted); margin: 28px 0 36px; max-width: 460px; }
  .rc-hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .rc-hero-stats { margin-top: 48px; padding-top: 28px; border-top: 1px solid rgba(42,37,34,0.13); display: flex; gap: 48px; }
  .rc-hero-stat-val { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 800; font-size: 28px; line-height: 1; }
  .rc-hero-stat-lbl { font-size: 11px; margin-top: 8px; color: var(--rc-muted); letter-spacing: 0.5px; }
  .rc-hero-img-wrap { position: relative; min-height: 460px; }
  .rc-hero-accent-bg {
    position: absolute; inset: 0; background: var(--rc-accent);
    border-radius: 28px 28px 200px 28px; transform: rotate(-2deg);
  }
  .rc-hero-img {
    position: absolute; inset: 16px 16px 16px 32px; border-radius: 24px; overflow: hidden;
    background: #222 url('https://images.unsplash.com/photo-1494976388531-d1058494cdd8?w=1200&auto=format&fit=crop&q=80') center/cover no-repeat;
    box-shadow: 0 20px 60px rgba(0,0,0,0.2);
  }
  .rc-hero-img-badge {
    position: absolute; left: 20px; bottom: 20px;
    background: rgba(255,255,255,0.92); backdrop-filter: blur(10px);
    padding: 12px 16px; border-radius: 14px;
    font-family: "JetBrains Mono", monospace; font-size: 10px; color: var(--rc-text); letter-spacing: 1px;
    display: flex; gap: 14px;
  }
  .rc-hero-img-badge .ready { color: var(--rc-accent); }
  .rc-hero-float-badge {
    position: absolute; top: -16px; right: -8px;
    background: #fff; padding: 14px 18px; border-radius: 16px;
    box-shadow: 0 12px 32px rgba(0,0,0,0.12); border: 1px solid var(--rc-border);
    font-family: "Zen Kaku Gothic New", sans-serif;
    display: flex; align-items: center; gap: 12px;
  }
  .rc-hero-float-icon {
    width: 40px; height: 40px; border-radius: 12px; background: var(--rc-line);
    display: flex; align-items: center; justify-content: center;
  }
  .rc-hero-float-sub { font-size: 11px; color: var(--rc-muted); }
  .rc-hero-float-val { font-weight: 800; font-size: 16px; color: var(--rc-text); }

  /* ── Features ── */
  .rc-features { padding: 88px 48px; background: var(--rc-bg); }
  .rc-feature-grid { margin-top: 48px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .rc-feature-card {
    background: var(--rc-card); border: 1px solid var(--rc-border); border-radius: 24px;
    padding: 32px; min-height: 220px; display: flex; flex-direction: column; justify-content: space-between;
  }
  .rc-feature-num { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--rc-accent); letter-spacing: 1.5px; }
  .rc-feature-title { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 800; font-size: 22px; color: var(--rc-text); margin-bottom: 10px; }
  .rc-feature-desc { font-size: 13.5px; color: var(--rc-muted); line-height: 1.8; }

  /* ── Steps ── */
  .rc-steps { padding: 88px 48px; background: var(--rc-hero-bg); }
  .rc-step-grid { margin-top: 48px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; position: relative; }
  .rc-step-card {
    background: var(--rc-card); border: 1px solid var(--rc-border); border-radius: 24px;
    padding: 36px; position: relative;
  }
  .rc-step-num {
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 900; font-size: 56px;
    color: var(--rc-accent); line-height: 1; letter-spacing: -2px; margin-bottom: 16px;
  }
  .rc-step-title { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 800; font-size: 24px; color: var(--rc-text); margin-bottom: 12px; }
  .rc-step-desc { font-size: 13.5px; color: var(--rc-muted); line-height: 1.8; }
  .rc-step-arrow {
    position: absolute; right: -22px; top: 50%; font-size: 24px; color: var(--rc-accent);
    transform: translateY(-50%); font-family: "JetBrains Mono", monospace; z-index: 1;
  }

  /* ── Vehicles ── */
  .rc-vehicles { padding: 88px 48px; background: var(--rc-bg); }
  .rc-vehicle-header { display: flex; justify-content: space-between; align-items: flex-end; }
  .rc-vehicle-sub { font-size: 14px; color: var(--rc-muted); line-height: 1.8; max-width: 400px; margin: 0; }
  .rc-vehicle-grid { margin-top: 48px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .rc-vehicle-card {
    background: var(--rc-card); border: 1px solid var(--rc-border); border-radius: 28px;
    padding: 32px; position: relative; overflow: hidden;
  }
  .rc-vehicle-tag {
    position: absolute; top: 20px; right: 20px;
    background: var(--rc-accent); color: #fff;
    padding: 5px 12px; border-radius: 14px;
    font-family: "JetBrains Mono", monospace; font-size: 10px; font-weight: 700; letter-spacing: 1px;
  }
  .rc-vehicle-class { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--rc-muted); letter-spacing: 1.5px; }
  .rc-vehicle-name { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 800; font-size: 28px; color: var(--rc-text); margin-top: 6px; }
  .rc-vehicle-model { font-size: 13px; color: var(--rc-muted); margin-top: 6px; }
  .rc-vehicle-img {
    margin: 20px -8px; height: 200px; border-radius: 18px; overflow: hidden;
    background-size: cover; background-position: center; position: relative;
  }
  .rc-vehicle-img::after {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0) 50%, rgba(0,0,0,0.25) 100%);
  }
  .rc-vehicle-prices { padding-top: 18px; border-top: 1px solid var(--rc-border); display: grid; grid-template-columns: repeat(4,1fr); gap: 8px; }
  .rc-price-label { font-family: "JetBrains Mono", monospace; font-size: 9px; color: var(--rc-muted); letter-spacing: 1px; margin-bottom: 4px; }
  .rc-price-val { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 800; font-size: 16px; color: var(--rc-text); }

  /* ── Scenes ── */
  .rc-scenes { padding: 88px 48px; background: var(--rc-bg); }
  .rc-scenes-header { display: flex; justify-content: space-between; align-items: flex-end; }
  .rc-scenes-sub { font-size: 14px; color: var(--rc-muted); line-height: 1.8; max-width: 400px; margin: 0; }
  .rc-scenes-grid { margin-top: 48px; display: grid; grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; gap: 16px; height: 540px; }
  .rc-scene-card {
    position: relative; overflow: hidden; border-radius: 24px;
    background-size: cover; background-position: center;
    display: flex; flex-direction: column; justify-content: space-between;
    padding: 28px; color: #fff; box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  .rc-scene-card::before {
    content: ""; position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.55) 100%);
  }
  .rc-scene-card-large { grid-row: span 2; }
  .rc-scene-top { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; }
  .rc-scene-code { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 2px; opacity: 0.85; }
  .rc-scene-tag {
    padding: 5px 12px; border-radius: 14px; background: rgba(255,255,255,0.18); backdrop-filter: blur(10px);
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.5px;
  }
  .rc-scene-bottom { position: relative; z-index: 1; }
  .rc-scene-time { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--rc-accent); letter-spacing: 1px; margin-bottom: 8px; }
  .rc-scene-title-lg { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 900; font-size: 36px; line-height: 1.15; letter-spacing: -0.8px; margin-bottom: 12px; }
  .rc-scene-title-sm { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 900; font-size: 24px; line-height: 1.15; letter-spacing: -0.8px; margin-bottom: 6px; }
  .rc-scene-desc-lg { font-size: 13.5px; line-height: 1.75; opacity: 0.9; max-width: 380px; }
  .rc-scene-desc-sm { font-size: 12px; line-height: 1.75; opacity: 0.9; }

  /* ── Voices ── */
  .rc-voices { padding: 88px 48px; background: var(--rc-hero-bg); }
  .rc-voice-grid { margin-top: 48px; display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
  .rc-voice-card { background: var(--rc-card); border: 1px solid var(--rc-border); border-radius: 24px; padding: 32px; }
  .rc-voice-stars { display: flex; gap: 3px; margin-bottom: 16px; }
  .rc-voice-heading { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 800; font-size: 18px; color: var(--rc-text); margin-bottom: 14px; line-height: 1.4; }
  .rc-voice-body { font-size: 13.5px; color: var(--rc-muted); line-height: 1.85; margin-bottom: 20px; }
  .rc-voice-who { padding-top: 18px; border-top: 1px solid var(--rc-border); display: flex; align-items: center; gap: 12px; }
  .rc-voice-avatar {
    width: 36px; height: 36px; border-radius: 50%; background: var(--rc-accent); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 700; font-size: 13px; flex-shrink: 0;
  }
  .rc-voice-id { font-family: "JetBrains Mono", monospace; font-size: 11px; color: var(--rc-text); letter-spacing: 1px; }

  /* ── Locations ── */
  .rc-locations { padding: 88px 48px; background: var(--rc-bg); }
  .rc-location-grid { margin-top: 36px; display: grid; grid-template-columns: repeat(6,1fr); gap: 12px; }
  .rc-location-card {
    background: var(--rc-card); border: 1px solid var(--rc-border); border-radius: 18px;
    padding: 20px; aspect-ratio: 1/1.1; display: flex; flex-direction: column; justify-content: space-between; position: relative; overflow: hidden;
  }
  .rc-location-card-last { background: var(--rc-accent); border: none; }
  .rc-location-sub { font-family: "JetBrains Mono", monospace; font-size: 9px; color: var(--rc-muted); letter-spacing: 1.5px; position: relative; z-index: 1; }
  .rc-location-sub-last { color: #fff; }
  .rc-location-name { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 800; font-size: 14px; color: var(--rc-text); line-height: 1.2; position: relative; z-index: 1; }
  .rc-location-name-last { color: #fff; }

  /* ── FAQ ── */
  .rc-faq { padding: 88px 48px; background: var(--rc-hero-bg); }
  .rc-faq-grid { margin-top: 40px; display: grid; grid-template-columns: 1fr 1fr; gap: 0 32px; }
  .rc-faq-item { border-top: 1px solid var(--rc-border); }
  .rc-faq-btn {
    width: 100%; background: transparent; border: none; padding: 22px 0;
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    cursor: pointer; text-align: left; color: var(--rc-text);
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 600; font-size: 15.5px; line-height: 1.5;
  }
  .rc-faq-q { flex: 1; }
  .rc-faq-q-prefix { color: var(--rc-accent); font-family: "JetBrains Mono", monospace; font-size: 12px; margin-right: 12px; }
  .rc-faq-icon {
    width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--rc-border);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    transition: transform .3s;
  }
  .rc-faq-icon.open { transform: rotate(45deg); }
  .rc-faq-answer {
    max-height: 0; overflow: hidden; transition: max-height .3s, padding-bottom .3s;
    font-size: 13.5px; line-height: 1.85; color: var(--rc-muted); padding-left: 30px;
  }
  .rc-faq-answer.open { max-height: 200px; padding-bottom: 22px; }

  /* ── Footer ── */
  .rc-footer { background: var(--rc-cta-bg); color: #FBF7F0; padding: 88px 48px 40px; }
  .rc-footer-grid { max-width: 1280px; margin: 0 auto; display: grid; grid-template-columns: 1.4fr 1fr; gap: 64px; align-items: center; }
  .rc-footer-eyebrow { font-family: "JetBrains Mono", monospace; font-size: 11px; letter-spacing: 3px; opacity: 0.6; margin-bottom: 16px; }
  .rc-footer-headline {
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 900; font-size: 64px;
    line-height: 1; margin: 0; letter-spacing: -2px;
  }
  .rc-footer-headline .accent { color: var(--rc-accent); }
  .rc-footer-sub { font-size: 14px; line-height: 1.85; opacity: 0.8; margin: 0 0 24px; }
  .rc-footer-actions { display: grid; gap: 12px; }
  .rc-footer-btn-line {
    width: 100%; padding: 22px; border-radius: 32px; border: none;
    background: var(--rc-line); color: #fff;
    font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 800; font-size: 16px; letter-spacing: 1px;
    display: flex; align-items: center; justify-content: center; gap: 10px;
    cursor: pointer; box-shadow: 0 8px 24px rgba(6,199,85,0.3);
  }
  .rc-footer-btn-back {
    width: 100%;
    padding: 18px;
    border-radius: 32px;
    border: 1px solid rgba(251,247,240,0.35);
    color: #FBF7F0;
    background: transparent;
    font-family: "Zen Kaku Gothic New", sans-serif;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.4px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background .2s ease, border-color .2s ease, transform .2s ease;
  }
  .rc-footer-btn-back:hover {
    background: rgba(251,247,240,0.08);
    border-color: rgba(251,247,240,0.6);
    transform: translateY(-1px);
  }
  .rc-footer-bottom { max-width: 1280px; margin: 64px auto 0; padding-top: 32px; border-top: 1px solid rgba(251,247,240,0.13); display: flex; justify-content: space-between; align-items: flex-end; }
  .rc-footer-brand { font-family: "Zen Kaku Gothic New", sans-serif; font-weight: 900; font-size: 18px; margin-bottom: 6px; }
  .rc-footer-brand-sub { font-family: "JetBrains Mono", monospace; font-size: 11px; opacity: 0.5; letter-spacing: 1px; }
  .rc-footer-links { display: flex; gap: 28px; font-size: 12px; opacity: 0.6; }
  .rc-footer-links a { color: inherit; text-decoration: none; }

  @media (max-width: 768px) {
    .rc-container { padding: 0 6px; }
    .rc-header {
      padding: 10px 6px;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .rc-nav {
      width: 100%;
      gap: 12px;
      overflow-x: auto;
      padding-bottom: 4px;
    }
    .rc-nav a { white-space: nowrap; font-size: 12px; }
    .rc-nav-back { padding: 7px 12px; font-size: 11px; }
    .rc-btn-line { padding: 9px 14px; }
    .rc-hero,
    .rc-features,
    .rc-steps,
    .rc-vehicles,
    .rc-scenes,
    .rc-voices,
    .rc-locations,
    .rc-faq,
    .rc-footer {
      padding-top: 56px;
      padding-bottom: 56px;
      padding-left: 6px;
      padding-right: 6px;
    }
    .rc-section-title { font-size: 34px; letter-spacing: -0.5px; }
    .rc-hero h1 { font-size: 44px; letter-spacing: -1px; }
    .rc-hero-sub { font-size: 14px; line-height: 1.75; margin: 20px 0 28px; }
    .rc-hero-grid,
    .rc-footer-grid { grid-template-columns: 1fr; gap: 32px; }
    .rc-hero-img-wrap { min-height: 280px; }
    .rc-hero-stats {
      gap: 24px;
      flex-wrap: wrap;
    }
    .rc-btn-line-lg,
    .rc-btn-outline {
      width: 100%;
      justify-content: center;
      text-align: center;
      padding: 15px 20px;
      font-size: 14px;
    }
    .rc-hero-stats { margin-top: 32px; padding-top: 20px; }
    .rc-hero-stat-val { font-size: 24px; }
    .rc-step-grid { grid-template-columns: 1fr; }
    .rc-step-arrow { display: none; }
    .rc-vehicle-header,
    .rc-scenes-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .rc-vehicle-grid,
    .rc-voice-grid,
    .rc-faq-grid { grid-template-columns: 1fr; }
    .rc-scenes-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
      height: auto;
    }
    .rc-scene-card,
    .rc-scene-card-large {
      grid-row: auto;
      min-height: 220px;
    }
    .rc-feature-grid { grid-template-columns: 1fr; margin-top: 32px; }
    .rc-feature-card,
    .rc-step-card,
    .rc-voice-card,
    .rc-vehicle-card { padding: 24px; border-radius: 20px; }
    .rc-feature-title { font-size: 20px; }
    .rc-step-num { font-size: 44px; }
    .rc-step-title { font-size: 20px; }
    .rc-vehicle-name { font-size: 24px; }
    .rc-vehicle-img { height: 170px; margin: 16px -4px; }
    .rc-vehicle-prices { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px 8px; }
    .rc-scene-card { min-height: 220px; padding: 22px; }
    .rc-scene-title-lg { font-size: 30px; }
    .rc-scene-title-sm { font-size: 22px; }
    .rc-location-grid { grid-template-columns: 1fr; }
    .rc-faq-btn { font-size: 14px; padding: 18px 0; }
    .rc-faq-answer { padding-left: 22px; font-size: 13px; }
    .rc-footer-headline { font-size: 46px; letter-spacing: -1px; }
    .rc-footer-sub { font-size: 13px; }
    .rc-footer-btn-line { padding: 18px; font-size: 15px; }
    .rc-footer-btn-back { padding: 16px; font-size: 14px; }
    .rc-hero-img { inset: 10px 10px 10px 18px; border-radius: 18px; }
    .rc-hero-accent-bg { border-radius: 20px 20px 120px 20px; }
    .rc-hero-float-badge {
      top: auto;
      right: 8px;
      bottom: 8px;
      padding: 10px 12px;
      border-radius: 12px;
    }
    .rc-hero-float-icon { width: 32px; height: 32px; border-radius: 10px; }
    .rc-hero-float-val { font-size: 14px; }
    .rc-hero-img-badge {
      left: 10px;
      bottom: 10px;
      padding: 8px 10px;
      gap: 8px;
      font-size: 9px;
    }
    .rc-scene-top { flex-direction: column; gap: 8px; }
    .rc-location-grid { grid-template-columns: 1fr; }
    .rc-footer-bottom {
      margin-top: 40px;
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .rc-footer-links { font-size: 11px; gap: 10px 14px; flex-wrap: wrap; }
    .rc-footer-brand-sub { font-size: 10px; }
  }
</style>
<% end %>

<div class="rc">

