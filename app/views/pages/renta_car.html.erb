            <div class="rc-hero-stat-lbl"><%= label %></div>
          </div>
          <% end %>
        </div>
      </div>
      <div class="rc-hero-img-wrap">
        <div class="rc-hero-accent-bg"></div>
        <div class="rc-hero-img">
          <div class="rc-hero-img-badge">
            <span>FUKUOKA</span><span style="opacity:0.4">·</span><span>24H</span><span style="opacity:0.4">·</span><span class="ready">● READY</span>
          </div>
        </div>
        <div class="rc-hero-float-badge">
          <div class="rc-hero-float-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="#fff"><path d="M19.365 9.863c.349 0 .63.285.63.631s-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .348-.281.632-.63.632H16.98c-.345 0-.627-.284-.627-.632V8.108c0-.345.282-.63.63-.63h2.382c.349 0 .63.285.63.63 0 .348-.281.63-.63.63H17.61v1.125h1.755zm-3.875 3.006c0 .275-.176.514-.437.601-.065.02-.134.031-.199.031-.211 0-.4-.091-.527-.258L12.34 10.99v1.876c0 .348-.281.631-.63.631-.347 0-.628-.284-.628-.631V8.108c0-.272.175-.513.437-.599.063-.018.134-.028.197-.028.211 0 .4.092.526.254l1.988 2.269V8.108c0-.345.283-.63.63-.63.35 0 .632.285.632.63v4.761zM9.879 12.866c0 .348-.281.632-.631.632-.345 0-.626-.284-.626-.632V8.108c0-.345.281-.63.626-.63.35 0 .631.285.631.63v4.758zM8.185 13.498H5.809c-.35 0-.631-.284-.631-.632V8.108c0-.345.281-.63.631-.63.346 0 .627.285.627.63v4.128H8.185c.347 0 .63.284.63.631 0 .348-.283.63-.63.63M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
          </div>
          <div>
            <div class="rc-hero-float-sub">最短</div>
            <div class="rc-hero-float-val">5分で予約完了</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%# ── Features ── %>
  <section class="rc-features" id="features">
    <div class="rc-container">
      <div class="rc-eyebrow">FEATURES</div>
      <h2 class="rc-section-title">マチナカが<br>選ばれる理由。</h2>
      <div class="rc-feature-grid">
        <% [
          ['01','24時間対応','早朝深夜OK、好きな時間に出発・返却。'],
          ['02','LINE予約','友達追加で、最短5分で予約完了。'],
          ['03','26拠点','福岡市・糸島市内に充実のネットワーク。'],
          ['04','明朗会計','追加料金なし、保険込みで安心の価格。'],
          ['05','保険込み','対人・対物・車両・人身傷害を全車標準。'],
          ['06','365日サポート','困ったときも公式LINEで素早く対応。'],
        ].each do |num, title, desc| %>
        <div class="rc-feature-card">
          <div class="rc-feature-num"><%= num %></div>
          <div>
            <div class="rc-feature-title"><%= title %></div>
            <div class="rc-feature-desc"><%= desc %></div>
          </div>
        </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Steps ── %>
  <section class="rc-steps" id="steps">
    <div class="rc-container">
      <div class="rc-eyebrow">HOW IT WORKS</div>
      <h2 class="rc-section-title">予約まで、<br>たった3ステップ。</h2>
      <div class="rc-step-grid">
        <% [
          ['01','公式LINE追加','マチナカレンタカーを友達追加。'],
          ['02','予約情報の入力','LINEで日時・車種・拠点を送信。'],
          ['03','申し込み確定','スタッフが空き確認し、予約確定。'],
        ].each_with_index do |(num, title, desc), i| %>
        <div class="rc-step-card">
          <div class="rc-step-num"><%= num %></div>
          <div class="rc-step-title"><%= title %></div>
          <div class="rc-step-desc"><%= desc %></div>
          <% if i < 2 %>
          <span class="rc-step-arrow">→</span>
          <% end %>
        </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Vehicles ── %>
  <section class="rc-vehicles" id="vehicles">
    <div class="rc-container">
      <div class="rc-vehicle-header">
        <div>
          <div class="rc-eyebrow">OUR FLEET</div>
          <h2 class="rc-section-title">車種・料金</h2>
        </div>
        <p class="rc-vehicle-sub">用途に合わせて、ちょうどいい一台を。<br>軽自動車から普通車まで4クラスをご用意。</p>
      </div>
      <div class="rc-vehicle-grid">
        <% [
          { cls: 'A', name: '軽自動車',     model: 'デイズ / ワゴンR',         tag: '人気',     img: 'https://images.unsplash.com/photo-1485463611174-f302f6a5c1c9?w=800&auto=format&fit=crop&q=80', color: '#EFC24D', prices: [['12h','3,000'],['24h','4,400'],['36h','7,400'],['60h','10,400']] },
          { cls: 'B', name: 'ハイルーフ軽', model: 'デイズルークス / タント',   tag: nil,        img: 'https://images.unsplash.com/photo-1549399542-7e3f8b79c341?w=800&auto=format&fit=crop&q=80', color: '#4AA373', prices: [['12h','3,300'],['24h','4,700'],['36h','8,000'],['60h','11,300']] },
          { cls: 'C', name: 'コンパクトカー', model: 'アクア / ノート / デミオ', tag: nil,        img: 'https://images.unsplash.com/photo-1542362567-b07e54358753?w=800&auto=format&fit=crop&q=80', color: '#3A6EA5', prices: [['12h','4,600'],['24h','6,000'],['36h','10,600'],['60h','15,200']] },
          { cls: 'D', name: 'ハイルーフ普通車', model: 'ソリオ / ルーミー',     tag: 'ファミリー', img: 'https://images.unsplash.com/photo-1606664515524-ed2f786a0bd6?w=800&auto=format&fit=crop&q=80', color: '#C55A3B', prices: [['12h','4,900'],['24h','6,300'],['36h','11,200'],['60h','16,100']] },
        ].each do |car| %>
        <div class="rc-vehicle-card">
          <% if car[:tag] %>
          <div class="rc-vehicle-tag"><%= car[:tag] %></div>
          <% end %>
          <div class="rc-vehicle-class">CLASS <%= car[:cls] %></div>
          <div class="rc-vehicle-name"><%= car[:name] %></div>
          <div class="rc-vehicle-model"><%= car[:model] %></div>
          <div class="rc-vehicle-img" style="background-color:<%= car[:color] %>22;background-image:url('<%= car[:img] %>')"></div>
          <div class="rc-vehicle-prices">
            <% car[:prices].each do |time, price| %>
            <div>
              <div class="rc-price-label"><%= time %></div>
              <div class="rc-price-val">¥<%= price %></div>
            </div>
            <% end %>
          </div>
        </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Scenes ── %>
  <section class="rc-scenes">
    <div class="rc-container">
      <div class="rc-scenes-header">
        <div>
          <div class="rc-eyebrow">USE CASES</div>
          <h2 class="rc-section-title">こんなシーンで、<br>マチナカ。</h2>
        </div>
        <p class="rc-scenes-sub">日常のちょっとした足から、<br>特別な一日まで。さまざまなシーンに。</p>
      </div>
      <div class="rc-scenes-grid">
        <% [
          { no: '01', en: 'COMMUTE',  title: '通勤・送迎',    time: '1〜3h',   tag: 'デイリー',   large: true,  img: 'https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?w=900&auto=format&fit=crop&q=80',  desc: '電車が止まった朝も、雨の下校迎えも。最寄り拠点からすぐ乗り出せる安心感。' },
          { no: '02', en: 'WEEKEND',  title: '週末の買い出し', time: '3〜12h',  tag: 'ファミリー', large: false, img: 'https://images.unsplash.com/photo-1601628828688-632f38a5a7d0?w=900&auto=format&fit=crop&q=80', desc: 'まとめ買いも、家電・家具の運搬も。ハイルーフなら大きな荷物も余裕で収納。' },
          { no: '03', en: 'LEISURE',  title: '糸島、海へ。',   time: '12〜24h', tag: 'トリップ',   large: false, img: 'https://images.unsplash.com/photo-1502920917128-1aa500764cbd?w=900&auto=format&fit=crop&q=80',  desc: '福岡からの日帰り旅行にちょうどいい。面倒な手続きなしで、そのまま出発。' },
          { no: '04', en: 'BUSINESS', title: 'ビジネス出張',   time: '24〜36h', tag: 'ビジネス',   large: false, img: 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?w=900&auto=format&fit=crop&q=80',  desc: '電車より柔軟に、タクシーよりコスパよく。複数点を回る営業にも。' },
        ].each do |s| %>
        <div class="rc-scene-card <%= s[:large] ? 'rc-scene-card-large' : '' %>"
             style="background-image:url('<%= s[:img] %>')">
          <div class="rc-scene-top">
            <span class="rc-scene-code">[<%= s[:no] %>] <%= s[:en] %></span>
            <span class="rc-scene-tag"><%= s[:tag] %></span>
          </div>
          <div class="rc-scene-bottom">
            <div class="rc-scene-time"><%= s[:time] %></div>
            <div class="<%= s[:large] ? 'rc-scene-title-lg' : 'rc-scene-title-sm' %>"><%= s[:title] %></div>
            <div class="<%= s[:large] ? 'rc-scene-desc-lg' : 'rc-scene-desc-sm' %>"><%= s[:desc] %></div>
          </div>
        </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Voices ── %>
  <section class="rc-voices">
    <div class="rc-container">
      <div class="rc-eyebrow">VOICES</div>
      <h2 class="rc-section-title">お客様の声</h2>
      <div class="rc-voice-grid">
        <% [
          { h: '手続が簡単で利用できた', n: 'A.S', t: 'はじめて利用しました。手続きや支払いも公式LINEでスムーズに借りれます。駅近くのパーキングから出発・返却できてとても助かりました。' },
          { h: '体験がとても良かった',   n: 'K.T', t: '24時間車を返却できるのはとても便利です。初めてここでレンタカーを借りた体験はとても良かったです。スタッフの返事も早い！' },
          { h: '不安もすぐに解消',       n: 'M.N', t: 'LINEのみのやりとりで不安でしたが、スタッフさんの迅速丁寧で全く問題なく利用できました。コスパも良くて家族も喜んでいます。' },
        ].each do |v| %>
        <div class="rc-voice-card">
          <div class="rc-voice-stars">
            <% 5.times do %>
            <svg width="14" height="14" viewBox="0 0 12 12"><path d="M6 1l1.5 3 3.5.5-2.5 2.5.5 3.5L6 9l-3 1.5.5-3.5L1 4.5 4.5 4z" fill="#E8693B"/></svg>
            <% end %>
          </div>
          <div class="rc-voice-heading">「<%= v[:h] %>」</div>
          <div class="rc-voice-body"><%= v[:t] %></div>
          <div class="rc-voice-who">
            <div class="rc-voice-avatar"><%= v[:n][0] %></div>
            <div class="rc-voice-id">USER <%= v[:n] %></div>
          </div>
        </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Locations ── %>
  <section class="rc-locations" id="locations">
    <div class="rc-container">
      <div class="rc-eyebrow">LOCATIONS</div>
      <h2 class="rc-section-title">主な拠点</h2>
      <p style="font-size:14px;color:var(--rc-muted);margin-top:14px;line-height:1.7;">福岡市・糸島市内、計26拠点。</p>
      <div class="rc-location-grid">
        <% [
          ['博多駅店','HAKATA'],
          ['天神駅店','TENJIN'],
          ['六本松駅店','ROPPONMATSU'],
          ['姪浜駅店','MEINOHAMA'],
          ['糸島高校前駅店','ITOSHIMA'],
          ['ほか 21拠点','+21 MORE'],
        ].each_with_index do |(name, sub), i| %>
        <div class="rc-location-card <%= i == 5 ? 'rc-location-card-last' : '' %>">
          <div class="rc-location-sub <%= i == 5 ? 'rc-location-sub-last' : '' %>"><%= sub %></div>
          <div class="rc-location-name <%= i == 5 ? 'rc-location-name-last' : '' %>"><%= name %></div>
        </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── FAQ ── %>
  <section class="rc-faq" id="faq">
    <div class="rc-container">
      <div class="rc-eyebrow">FAQ</div>
      <h2 class="rc-section-title">よくある質問</h2>
      <div class="rc-faq-grid">
        <% [
          ['24時間いつでも出発・返却できますか？','事前予約いただければ、早朝・深夜を問わず24時間出発・返却が可能です。'],
          ['当日すぐに借りられますか？','空き状況によります。まずは公式LINEからお問い合わせください。スタッフが素早くご案内します。'],
          ['予約はLINEだけでできますか？','はい、公式LINEを友達追加いただくだけで、予約から確定までLINE上で完結します。'],
          ['キャンセル料はかかりますか？','ご予約内容により異なりますので、公式LINEでスタッフにお気軽にお尋ねください。'],
          ['支払い方法は？','公式LINEでのやりとりで、スムーズにお支払いが可能です。詳しくはお問い合わせください。'],
          ['免許を取ったばかりでも借りられますか？','初心者マークの方も歓迎です。運転に不安がある場合は、店舗スタッフが丁寧にご案内いたします。'],
        ].each_with_index do |(q, a), i| %>
        <div class="rc-faq-item">
          <button class="rc-faq-btn" onclick="rcToggleFaq(<%= i %>)" type="button">
            <span class="rc-faq-q"><span class="rc-faq-q-prefix">Q.</span><%= q %></span>
            <span class="rc-faq-icon" id="rc-faq-icon-<%= i %>">
              <svg width="12" height="12" viewBox="0 0 10 10"><path d="M5 1v8M1 5h8" stroke="#2A2522" stroke-width="1.4" stroke-linecap="round"/></svg>
            </span>
          </button>
          <div class="rc-faq-answer" id="rc-faq-answer-<%= i %>"><%= a %></div>
        </div>
        <% end %>
      </div>
    </div>
  </section>

  <%# ── Footer ── %>
  <footer class="rc-footer">
    <div class="rc-footer-grid">
